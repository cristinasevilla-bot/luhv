+<!-- ── LIVE FRONTEND ERROR CAPTURER ─────────────────────────────────────────
+     Captures uncaught JS errors, unhandled promise rejections, failed resource
+     loads and console.error/warn from THIS admin page, into the
+     "Live JS Errors" panel. Last 100 kept in sessionStorage. -->
+<script>
+(function(){
+  if (window.__debugLoggerInstalled) return;
+  window.__debugLoggerInstalled = true;
+
+  const STORE_KEY = '__meltos_debug_errors';
+  let errors = [];
+  try { errors = JSON.parse(sessionStorage.getItem(STORE_KEY) || '[]'); } catch(e){ errors = []; }
+
+  function persist(){
+    try { sessionStorage.setItem(STORE_KEY, JSON.stringify(errors.slice(-100))); } catch(e){}
+  }
+
+  function escapeHtml(s){
+    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  }
+
+  function renderErrors(){
+    const el = document.getElementById('debug-live-errors');
+    if (!el) return;
+    if (errors.length === 0){
+      el.innerHTML = '<div class="empty">No frontend errors logged ✅</div>';
+      return;
+    }
+    const rows = errors.slice().reverse().map(e => {
+      const color = e.level === 'error' ? '#ff6b6b' : (e.level === 'warn' ? '#ffd166' : '#9aa');
+      const time = new Date(e.ts).toLocaleTimeString();
+      const loc = e.source ? `${e.source}${e.line?':'+e.line:''}${e.col?':'+e.col:''}` : '';
+      return `<div style="border-left:3px solid ${color};padding:6px 10px;margin:6px 0;background:rgba(255,255,255,0.03);border-radius:4px;font-family:monospace;font-size:12px;">
+        <div style="display:flex;justify-content:space-between;gap:8px;">
+          <span style="color:${color};font-weight:600;text-transform:uppercase;">${e.level}</span>
+          <span style="color:#888;">${time}</span>
+        </div>
+        <div style="color:#ddd;margin-top:2px;white-space:pre-wrap;word-break:break-word;">${escapeHtml(e.message)}</div>
+        ${loc ? `<div style="color:#777;margin-top:2px;">${escapeHtml(loc)}</div>`:''}
+        ${e.stack ? `<details style="margin-top:4px;"><summary style="cursor:pointer;color:#888;">stack</summary><pre style="white-space:pre-wrap;color:#999;margin:4px 0 0;">${escapeHtml(e.stack)}</pre></details>`:''}
+      </div>`;
+    }).join('');
+    el.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
+        <span style="color:#aaa;font-size:13px;">${errors.length} mensaje(s) capturado(s)</span>
+        <button id="debug-clear-errors" style="background:#2a2a2a;border:1px solid #444;color:#ccc;padding:3px 10px;border-radius:4px;cursor:pointer;font-size:12px;">🗑 Limpiar</button>
+      </div>${rows}`;
+    const clearBtn = document.getElementById('debug-clear-errors');
+    if (clearBtn) clearBtn.onclick = () => { errors = []; persist(); renderErrors(); };
+  }
+
+  function addEntry(level, message, extra){
+    errors.push(Object.assign({ level, message, ts: Date.now() }, extra||{}));
+    if (errors.length > 100) errors = errors.slice(-100);
+    persist();
+    const pd = document.getElementById('page-debug');
+    if (pd && getComputedStyle(pd).display !== 'none') renderErrors();
+  }
+
+  // 1) Uncaught JS errors + failed resource loads
+  window.addEventListener('error', function(ev){
+    if (ev.message){
+      addEntry('error', ev.message, {
+        source: ev.filename, line: ev.lineno, col: ev.colno,
+        stack: ev.error && ev.error.stack ? ev.error.stack : ''
+      });
+    } else if (ev.target && (ev.target.src || ev.target.href)){
+      addEntry('error', 'Recurso no cargado: ' + (ev.target.src || ev.target.href), {});
+    }
+  }, true);
+
+  // 2) Unhandled promise rejections
+  window.addEventListener('unhandledrejection', function(ev){
+    const r = ev.reason;
+    addEntry('error', 'Promesa rechazada: ' + (r && r.message ? r.message : String(r)), {
+      stack: r && r.stack ? r.stack : ''
+    });
+  });
+
+  // 3) Intercept console.error / console.warn
+  ['error','warn'].forEach(function(level){
+    const orig = console[level].bind(console);
+    console[level] = function(...args){
+      try {
+        const msg = args.map(a => {
+          if (a instanceof Error) return a.message;
+          if (typeof a === 'object') { try { return JSON.stringify(a); } catch(e){ return String(a); } }
+          return String(a);
+        }).join(' ');
+        const stack = args.find(a => a instanceof Error);
+        addEntry(level, msg, { stack: stack && stack.stack ? stack.stack : '' });
+      } catch(e){}
+      orig(...args);
+    };
+  });
+
+  window.MeltosDebug = {
+    log: (msg) => addEntry('info', String(msg)),
+    render: renderErrors,
+    clear: () => { errors = []; persist(); renderErrors(); },
+    getAll: () => errors.slice()
+  };
+
+  document.addEventListener('DOMContentLoaded', renderErrors);
+  renderErrors();
+})();
+</script>
 </body>
 </html>
